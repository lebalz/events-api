{
    "compilerOptions": {
        "strict": true,
        "lib": ["esnext"],
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "../../dist/view-migrations",
        "rootDir": "./",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "ignoreDeprecations": "6.0",
        "baseUrl": "../../",
        "paths": {
            "*": ["node_modules/*"]
        }
    }
}